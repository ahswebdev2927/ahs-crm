# Environment Variables Example for AHS CRM

# App Environment
APP_ENV=development

# Database Configuration (Turso/libSQL for production, SQLite locally)
# For local SQLite development, you can use: "file:local.db" or "file:dev.db"
DATABASE_URL=file:dev.db
# For production Turso:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Authentication
JWT_SECRET=your_jwt_access_token_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Logging (Pino config if needed, e.g., LOG_LEVEL)
LOG_LEVEL=info
